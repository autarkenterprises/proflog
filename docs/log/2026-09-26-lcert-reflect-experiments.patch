--- a/code/lcert/src/lcert/syntax.clj	2026-09-26 22:58:30.629695572 +0000
+++ b/code/lcert/src/lcert/syntax.clj	2026-09-26 22:56:28.146083324 +0000
@@ -235,6 +235,28 @@
